# Supabase — copy these values from your Supabase project dashboard
# Settings > API > Project URL and Project API keys (anon/public)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Only needed for server-side admin operations (do NOT expose in client)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bitrix24 "local application" SSO — used only by api/bitrix/session.ts
# (never sent to the browser). Comma-separated list of portal domains
# allowed to sign accountants in this way.
# BITRIX_ALLOWED_DOMAINS=b24-0yxl7o.bitrix24.com

# Optional: force specific Bitrix24 user ids to sign in as a specific
# Transpare email, for someone whose Bitrix email doesn't match their
# Transpare account. Comma-separated "bitrixUserId:email" pairs.
# BITRIX_USER_EMAIL_OVERRIDES=8:it@egconnects.com
